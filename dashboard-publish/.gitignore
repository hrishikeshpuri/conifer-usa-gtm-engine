*credentials*
*api_keys*
secrets.toml
*.sqlite
*.sqlite3
*.db
*.log
*.csv
*.tsv
*.xlsx
*.xls
/output/
/apis/
/.venv/
/.dashboard-venv/
/.dashboard-runtime/
/__pycache__/

!/supabase_dashboard.py
